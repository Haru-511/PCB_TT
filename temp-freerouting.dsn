      (pins SPI_ANAL1-5 SPI_RAM_CONNECTOR1-5 OUTPUT1-4)
    )
    (net spi_clk_ram
      (pins SPI_ANAL1-6 SPI_RAM_CONNECTOR1-2 OUTPUT1-5)
    )
    (net "D0 ram"
      (pins SPI_ANAL1-7 SPI_RAM_CONNECTOR1-4 INPUT1-2)
    )
    (net spi_mosi_ram
      (pins SPI_ANAL1-8 SPI_RAM_CONNECTOR1-1 OUTPUT1-2)
    )
    (net "unconnected-(SPI_ANAL1-Pin_9-Pad9)"
      (pins SPI_ANAL1-9)
    )
    (net cs_bridge
      (pins SPI_BRIDGE1-2 U1-2 U1-9 U1-10 U1-11)
    )
    (net spi_cs_n
      (pins U1-1 OUTPUT1-3)
    )
    (net spi_mosi
      (pins U1-3 OUTPUT1-1)
    )
    (net "mosi brid"
      (pins SPI_BRIDGE1-3 U1-5)
    )
    (net "clk brid"
      (pins SPI_BRIDGE1-1 U1-12)
    )
    (net spi_clk
      (pins U1-13 OUTPUT1-6)
    )
    (net RXD
      (pins INPUT1-3)
    )
    (net "unconnected-(INPUT1-Pin_4-Pad4)"
      (pins INPUT1-4)
    )
    (net "unconnected-(INPUT1-Pin_5-Pad5)"
      (pins INPUT1-5)
    )
    (net "unconnected-(INPUT1-Pin_6-Pad6)"
      (pins INPUT1-6)
    )
    (net "unconnected-(INPUT1-Pin_7-Pad7)"
      (pins INPUT1-7)
    )
    (net "unconnected-(INPUT1-Pin_8-Pad8)"
      (pins INPUT1-8)
    )
    (net LEDS
      (pins OUTPUT1-7)
    )
    (net TXD
      (pins OUTPUT1-8)
    )
    (class kicad_default +3.3V "CS flash" "D0 flash" "D0 ram" "D1 flash" GND
      LEDS RXD TXD "clk brid" "clk flash" cs_bridge "mosi brid" spi_clk spi_clk_ram
      spi_cs_n spi_cs_n_ram spi_mosi spi_mosi_ram "unconnected-(INPUT1-Pin_4-Pad4)"
      "unconnected-(INPUT1-Pin_5-Pad5)" "unconnected-(INPUT1-Pin_6-Pad6)"
      "unconnected-(INPUT1-Pin_7-Pad7)" "unconnected-(INPUT1-Pin_8-Pad8)"
      "unconnected-(SPI_ANAL1-Pin_9-Pad9)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
